# Font Configuration
command = /usr/bin/fish
font-family = Iosevka Nerd Font
font-size = 13

# Window Configuration
window-decoration = false
window-padding-x = 12
window-padding-y = 12
background-opacity = 1.0
background-blur-radius = 32

# Cursor Configuration
cursor-style = bar
cursor-style-blink = false

# Scrollback
scrollback-limit = 10000000

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable in-app Ghostty toast notifications
app-notifications = false

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
# Application-first: release Ghostty defaults that conflict with OpenCode, Vim,
# herdr, or application shortcuts. Use Ctrl+B chords and F3 for terminal actions.
keybind = performable:ctrl+c=copy_to_clipboard:mixed
keybind = ctrl+t=unbind
keybind = ctrl+f=unbind
keybind = ctrl+enter=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+minus=unbind
keybind = ctrl+0=unbind
keybind = ctrl+shift+plus=unbind
keybind = ctrl+shift+equal=unbind
keybind = ctrl+shift+minus=unbind
keybind = ctrl+shift+0=unbind
keybind = page_up=unbind
keybind = page_down=unbind
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = alt+digit_9=unbind
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind
keybind = ctrl+alt+arrow_up=unbind
keybind = ctrl+alt+arrow_down=unbind
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+shift+f=start_search
keybind = f2=new_split:down
keybind = f3=new_tab
keybind = ctrl+shift+1=goto_tab:1
keybind = ctrl+shift+2=goto_tab:2
keybind = ctrl+shift+3=goto_tab:3
keybind = ctrl+shift+4=goto_tab:4
keybind = ctrl+shift+5=goto_tab:5
keybind = ctrl+shift+6=goto_tab:6
keybind = ctrl+shift+7=goto_tab:7
keybind = ctrl+shift+8=goto_tab:8
keybind = ctrl+shift+9=goto_tab:9

# Ctrl+B leader actions.
keybind = ctrl+b>ctrl+b=text:\x02
keybind = ctrl+b>ctrl+h=goto_split:left
keybind = ctrl+b>ctrl+j=goto_split:down
keybind = ctrl+b>ctrl+k=goto_split:up
keybind = ctrl+b>ctrl+l=goto_split:right
keybind = ctrl+b>ctrl+minus=new_split:down
keybind = ctrl+b>ctrl+shift+backslash=new_split:right
keybind = ctrl+b>ctrl+shift+h=resize_split:left,5
keybind = ctrl+b>ctrl+shift+j=resize_split:down,5
keybind = ctrl+b>ctrl+shift+k=resize_split:up,5
keybind = ctrl+b>ctrl+shift+l=resize_split:right,5
keybind = ctrl+b>ctrl+shift+x=toggle_tab_overview
keybind = ctrl+b>ctrl+shift+r=prompt_tab_title
keybind = ctrl+b>ctrl+p=move_tab:-1
keybind = ctrl+b>ctrl+n=move_tab:1
keybind = ctrl+b>left=previous_tab
keybind = ctrl+b>right=next_tab
keybind = ctrl+b>equal=increase_font_size:1
keybind = ctrl+b>minus=decrease_font_size:1
keybind = ctrl+b>0=reset_font_size
keybind = ctrl+b>ctrl+o=text:opencode2\n
keybind = ctrl+b>ctrl+t=text:herdr\n
keybind = ctrl+b>ctrl+f=text:tv\n
keybind = ctrl+b>ctrl+s=text:git status\n
keybind = ctrl+b>ctrl+shift+a=text:git add .\n
keybind = ctrl+b>ctrl+c=text:git commit -ae\n
keybind = ctrl+b>ctrl+alt+c=text:git commit -ae --amend\n
keybind = ctrl+b>ctrl+shift+c=text:git commit -m ""\x1b[D
keybind = ctrl+b>ctrl+shift+p=text:git push
keybind = ctrl+b>ctrl+shift+u=text:git pull
keybind = ctrl+b>ctrl+shift+f=text:git fetch\n
keybind = ctrl+b>ctrl+d=text:git diff
keybind = ctrl+b>ctrl+shift+g=text:git log --oneline --graph --decorate -20\n
keybind = ctrl+b>ctrl+shift+b=text:git branch\n
keybind = ctrl+b>ctrl+shift+o=text:git checkout\x20
keybind = ctrl+b>ctrl+w=text:git switch\x20
keybind = ctrl+b>ctrl+shift+n=text:git switch -c\x20
keybind = ctrl+b>ctrl+r=text:git restore\x20
keybind = ctrl+b>ctrl+alt+r=text:git reset --hard
keybind = ctrl+b>ctrl+shift+t=text:git stash\n
keybind = ctrl+b>ctrl+alt+t=text:git stash pop\n
keybind = ctrl+b>ctrl+e=text:git rebase\x20
keybind = ctrl+b>ctrl+m=text:git merge\x20
keybind = ctrl+b>ctrl+y=text:git cherry-pick\x20
keybind = ctrl+b>ctrl+alt+k=text:git clone\x20
keybind = ctrl+b>ctrl+shift+s=text:git show\n
keybind = ctrl+b>ctrl+alt+shift+b=text:git blame\x20
keybind = ctrl+b>ctrl+g=text:lazygit\n

# Material 3 UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Tab configuration
gtk-titlebar = false

# Shell integration
shell-integration = detect
shell-integration-features = no-cursor,sudo,title
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true

# Dank color generation
theme = dankcolors
